# Local API base URL for the salon backend.
# Use the same API origin in development and production deployments.
REACT_APP_API_BASE_URL=http://localhost:8080

# Required for secure admin authentication. The endpoint must validate
# credentials server-side and issue an HttpOnly, Secure, SameSite session cookie.
REACT_APP_ADMIN_LOGIN_ENDPOINT=http://localhost:8080/api/auth/login
